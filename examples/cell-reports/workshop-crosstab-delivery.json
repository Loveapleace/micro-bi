        "column": 2
      },
      "content": {
        "kind": "field",
        "fieldId": "plan_start_time",
        "fieldKey": "plan_start_time",
        "role": "column-dimension",
        "operation": "group",
        "expand": "right",
        "timeBucket": {
          "granularity": "day"
        },
        "displayName": "计划投产日"
      },
      "parents": {
        "row": null,
        "column": null
      },
      "style": {
        "bold": true,
        "textAlign": "center"
      }
