      "parents": {
        "row": "workshop",
        "column": null
      },
      "content": {
        "kind": "literal",
        "value": "加权缺陷率"
      },
      "style": {
        "textAlign": "center"
      }
    },
    {
      "id": "quantity",
      "sheetId": "sheet-1",
      "regionId": "delivery-region",
      "position": {
        "row": 4,
        "column": 2
      },
      "content": {
        "kind": "field",
        "fieldId": "output_qty",
        "fieldKey": "output_qty",
        "metricId": "qty-sum",
        "role": "measure",
        "operation": "sum",
        "expand": "inherit",
        "displayName": "交付件数",
        "format": "number"
      },
      "parents": {
        "row": "workshop",
        "column": "plan-date"
      },
      "style": {
        "textAlign": "right",
        "color": "#1677ff",
        "bold": true
      }
    },
    {
      "id": "defects",
      "sheetId": "sheet-1",
      "regionId": "delivery-region",
      "position": {
        "row": 5,
        "column": 2
      },
      "content": {
        "kind": "field",
        "fieldId": "defect_count",
        "fieldKey": "defect_count",
        "metricId": "defect-sum",
        "role": "measure",
        "operation": "sum",
        "expand": "inherit",
        "displayName": "缺陷零件数",
        "format": "number"
      },
      "parents": {
        "row": "workshop",
        "column": "plan-date"
      },
      "style": {
        "textAlign": "right"
      }
    },
    {
      "id": "defect-rate",
      "sheetId": "sheet-1",
      "regionId": "delivery-region",
      "position": {
        "row": 6,
        "column": 2
      },
      "content": {
        "kind": "business-formula",
        "metricId": "defect-rate",
        "expression": "IF([SUM(output_qty)] > 0, [SUM(defect_count)] / [SUM(output_qty)], 0)",
        "scope": "summary",
        "precision": 4,
        "displayName": "加权缺陷率",
        "format": "percent"
      },
      "parents": {
        "row": "workshop",
        "column": "plan-date"
      },
      "style": {
        "textAlign": "right",
        "bold": true,
        "color": "#d46b08"
      }
    }
