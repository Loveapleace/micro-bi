{
  "name": "micro-bi",
  "version": "0.1.0",
  "description": "MicroBI: 纯前端高性能轻量级嵌入式 BI 分析套件与 VisActor Canvas 看板引擎",
  "keywords": [
    "micro-bi",
    "bi",
    "embedded-bi",
    "visactor",
    "vtable",
    "vchart",
    "pivot",
    "dashboard",
    "analytics",
    "cross-filtering",
    "data-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loveapleace/micro-bi.git"
  },
  "bugs": {
    "url": "https://github.com/Loveapleace/micro-bi/issues"
  },
  "homepage": "https://github.com/Loveapleace/micro-bi#readme",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/esm/core/index.d.ts"
      ],
      "engine": [
        "./dist/esm/engine/index.d.ts"
      ],
      "ui": [
        "./dist/esm/ui/index.d.ts"
      ],
      "locale": [
        "./dist/esm/locale/index.d.ts"
      ],
      "report": [
        "./dist/esm/report/index.d.ts"
      ],
      "univer": [
        "./dist/esm/univer/index.d.ts"
      ],
      "cell-designer": [
        "./dist/esm/cell-designer/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core/index.d.ts",
        "default": "./dist/esm/core/index.js"
      },
      "require": {
        "types": "./dist/esm/core/index.d.ts",
        "default": "./dist/cjs/core/index.js"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/esm/engine/index.d.ts",
        "default": "./dist/esm/engine/index.js"
      },
      "require": {
        "types": "./dist/esm/engine/index.d.ts",
        "default": "./dist/cjs/engine/index.js"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/esm/ui/index.d.ts",
        "default": "./dist/esm/ui/index.js"
      },
      "require": {
        "types": "./dist/esm/ui/index.d.ts",
        "default": "./dist/cjs/ui/index.js"
      }
    },
    "./locale": {
      "import": {
        "types": "./dist/esm/locale/index.d.ts",
        "default": "./dist/esm/locale/index.js"
      },
      "require": {
        "types": "./dist/esm/locale/index.d.ts",
        "default": "./dist/cjs/locale/index.js"
      }
    },
    "./report": {
      "import": {
        "types": "./dist/esm/report/index.d.ts",
        "default": "./dist/esm/report/index.js"
      },
      "require": {
        "types": "./dist/esm/report/index.d.ts",
        "default": "./dist/cjs/report/index.js"
      }
    },
    "./univer": {
      "import": {
        "types": "./dist/esm/univer/index.d.ts",
        "default": "./dist/esm/univer/index.js"
      },
      "require": {
        "types": "./dist/esm/univer/index.d.ts",
        "default": "./dist/cjs/univer/index.js"
      }
    },
    "./cell-designer": {
      "import": {
        "types": "./dist/esm/cell-designer/index.d.ts",
        "default": "./dist/esm/cell-designer/index.js"
      },
      "require": {
        "types": "./dist/esm/cell-designer/index.d.ts",
        "default": "./dist/cjs/cell-designer/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5.0.0",
    "@univerjs/core": ">=1.1.0",
    "@univerjs/preset-sheets-core": ">=1.1.0",
    "@univerjs/presets": ">=1.1.0",
    "@univerjs/sheets": ">=1.1.0",
    "@visactor/vchart": ">=2.0.0",
    "@visactor/vtable": ">=1.26.0",
    "antd": ">=5.24.0 <6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@ant-design/icons": {
      "optional": true
    },
    "@univerjs/core": {
      "optional": true
    },
    "@univerjs/preset-sheets-core": {
      "optional": true
    },
    "@univerjs/presets": {
      "optional": true
    },
    "@visactor/vchart": {
      "optional": true
    },
    "@visactor/vtable": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@univerjs/sheets": {
      "optional": true
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/postbuild.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:only",
    "test:only": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@univerjs/core": "^1.1.0",
    "@univerjs/preset-sheets-core": "^1.1.0",
    "@univerjs/presets": "^1.1.0",
    "@univerjs/sheets": "^1.1.0",
    "@visactor/vchart": "^2.1.7",
    "@visactor/vtable": "^1.26.8",
    "antd": "^5.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "numfmt": "4.1.1"
  }
}
